APP_NAME = "rag application"
APP_VERSION = "0.1"

FILE_ALLOWED_EXTENSIONS = ["text/plain", "applications/pdf"]
FILE_MAX_SIZE = 10 

FILE_DEFAULT_CHUNK_SIZE = 512000

POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="PASSWORD"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="rag"

# LLM Config
GENERATION_BACKEND= "GROQ"
EMBEDDING_BACKEND= "COHERE"

OPENAI_API_KEY= ""
OPENAI_API_URL= ""

COHERE_API_KEY = ""
GROQ_API_KEY = ""

GENERATION_MODEL_ID = "llama-3.1-8b-instant"
EMBEDDING_MODEL_ID = "embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE = 384

DEFAULT_INPUT_MAX_CHARACTERS = 1024
GENERATION_DEFAULT_MAX_TOKENS = 200
GENERATION_DEFAULT_MAX_TEMPRATURE = 0.1

# ================= VectorDB Config ==================
VECTOR_DB_BACKEND = "PGVECTOR" # PGVECTOR, QDRANT
VECTOR_DB_PATH = "qdrant_db"
VECTOR_DB_DISTANCE_METRIC = "cosine"

# ================= Templates Configs ==================
PRIMARY_LANG = "ar"
DEFAULT_LANG = "en"